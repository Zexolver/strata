{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Browser chrome only. Web content webviews get no capability and therefore no IPC.",
  "windows": ["main"],
  "webviews": ["ui"],
  "permissions": [
    "core:event:default",
    "allow-get-state", "allow-open-settings", "allow-new-tab", "allow-close-tab", "allow-switch-tab", "allow-navigate",
    "allow-history-back", "allow-history-forward", "allow-reload", "allow-update-settings",
    "allow-add-profile", "allow-remove-profile",
    "allow-set-overlay"
  ]
}
